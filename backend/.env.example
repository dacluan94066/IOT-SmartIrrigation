# Chỉ bind loopback; không port-forward router/tunnel công khai.
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/irrigation.sqlite
DEVICE_ID=esp32-01
DEVICE_API_TOKEN=
ADMIN_API_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Chỉ dùng HTTP trong Gateway local tin cậy, không dùng cho mạng Internet.
DEVICE_BACKEND_URL=http://host.wokwi.internal:3001
# Chạy npm run provision-dashboard để sinh hash; không đặt API token vào VITE_*.
# DASHBOARD_PASSWORD_HASH=scrypt$<salt>$<hash>
DASHBOARD_OFFLINE_MS=30000
DASHBOARD_COOKIE_SECURE=false
# Chỉ bật khi demo trên Wokwi; không dùng dữ liệu mô phỏng cho bơm ngoài thực tế.
REMOTE_DEMO_ENABLED=false
